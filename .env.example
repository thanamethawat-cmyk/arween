# จำเป็นสำหรับแพลตฟอร์มใช้จริง (Prisma + NextAuth)
# Local (ค่าเริ่มต้นที่ใช้งานได้ทันทีโดยไม่ต้องติดตั้ง Postgres):
DATABASE_URL="file:./dev.db"
# Production / Docker Postgres (ถ้ามี):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arween
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (สำหรับเข้าสู่ระบบด้วย Google ผ่านลิงก์เชิญ)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini (Agent 1) — ถ้าไม่ใส่จะใช้ heuristic ในเครื่อง
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Firebase (ต้นแบบสาธิตเก่า — ไม่ใช่ UX หลักแล้ว)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
