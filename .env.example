# จำเป็นสำหรับแพลตฟอร์มใช้จริง (Prisma + NextAuth + Postgres)
# เปิด DB: docker compose up -d db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arween?schema=public"
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (สำหรับเข้าสู่ระบบด้วย Google ผ่านลิงก์เชิญ)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini (Agent 1 + แชท) — แนะนำ gemini-2.0-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Firebase (ต้นแบบสาธิตเก่า — ไม่โหลดใน UX หลักแล้ว)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
