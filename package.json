{
  "name": "arween",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "node scripts/sync-prisma-provider.js && prisma generate && next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "db:up": "docker compose up -d db",
    "db:generate": "node scripts/sync-prisma-provider.js && prisma generate",
    "db:push": "node scripts/sync-prisma-provider.js && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "node scripts/sync-prisma-provider.js && prisma db push && tsx prisma/seed.ts",
    "pilot:simulate": "tsx scripts/run-pilot-simulation.ts",
    "verify:cycle": "tsx scripts/verify-full-cycle.ts",
    "ai:calibrate": "tsx scripts/calibrate-ai-prompts.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "lucide-react": "^0.469.0",
    "next": "^14.2.21",
    "next-auth": "^4.24.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
