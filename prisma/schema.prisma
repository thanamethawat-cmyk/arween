generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  passwordHash     String?
  emailVerified    DateTime?
  role             UserRole            @default(MEMBER)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  memberships      ProjectMember[]
  evidenceEvents   EvidenceEvent[]
  scores           Score[]
  disputes         Dispute[]
  invitesSent      ProjectInvite[]     @relation("InvitesSent")
  contributionShares ContributionShare[]
  periodsClosed    EvaluationPeriod[]  @relation("PeriodClosedBy")
}

enum UserRole {
  MEMBER
  LEAD
  ADMIN
}

model Project {
  id            String             @id @default(cuid())
  name          String
  description   String?
  status        ProjectStatus      @default(ACTIVE)
  progressPercent Float            @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  members       ProjectMember[]
  workItems     WorkItem[]
  documents     DocumentRef[]
  evidence      EvidenceEvent[]
  notifications Notification[]
  scores        Score[]
  teamSummaries TeamSummary[]
  disputes      Dispute[]
  invites       ProjectInvite[]
  objectives    Objective[]
  periods       EvaluationPeriod[]
}

model ProjectInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  projectId   String
  email       String
  role        String    @default("member")
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([projectId])
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Objective {
  id          String      @id @default(cuid())
  projectId   String
  name        String
  description String?
  weight      Int
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestones  Milestone[]

  @@index([projectId])
}

model Milestone {
  id               String          @id @default(cuid())
  objectiveId      String
  name             String
  successCriteria  String
  weight           Int
  status           AnchorStatus    @default(NOT_STARTED)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  objective        Objective       @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  kpis             Kpi[]
  scores           Score[]

  @@index([objectiveId])
}

model Kpi {
  id           String       @id @default(cuid())
  milestoneId  String
  name         String
  unit         String
  targetValue  Float
  currentValue Float        @default(0)
  weight       Int
  status       AnchorStatus @default(NOT_STARTED)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  milestone    Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  scores       Score[]

  @@index([milestoneId])
}

enum AnchorStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  AT_RISK
}

model WorkItem {
  id          String         @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      WorkItemStatus @default(TODO)
  assigneeId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum WorkItemStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

model DocumentRef {
  id        String   @id @default(cuid())
  projectId String
  title     String
  url       String
  addedById String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model EvidenceEvent {
  id          String         @id @default(cuid())
  projectId   String
  actorId     String
  action      String
  source      EvidenceSource
  occurredAt  DateTime       @default(now())
  metadata    Json?
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       User           @relation(fields: [actorId], references: [id], onDelete: Cascade)
  scores      Score[]

  @@index([projectId])
}

enum EvidenceSource {
  WORK_ITEM
  COMMENT
  DOCUMENT
  STATUS_UPDATE
  DAILY_LOG
}

model Notification {
  id        String           @id @default(cuid())
  projectId String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  WEEKLY_DIGEST
  GAMING_FLAG
  DISPUTE_PENDING
}

model EvaluationPeriod {
  id              String              @id @default(cuid())
  projectId       String
  periodStart     DateTime
  periodEnd       DateTime
  status          PeriodStatus        @default(OPEN)
  closedAt        DateTime?
  closedById      String?
  meritStatus     String              @default("NONE")
  meritApprovedAt DateTime?
  poolAmount      Float?
  currency        String              @default("THB")
  createdAt       DateTime            @default(now())
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  closedBy        User?               @relation("PeriodClosedBy", fields: [closedById], references: [id])
  scores          Score[]
  shares          ContributionShare[]

  @@index([projectId])
}

enum PeriodStatus {
  OPEN
  CLOSED
}

model ContributionShare {
  id            String           @id @default(cuid())
  periodId      String
  userId        String
  ratioPercent  Float
  impactSum     Float
  confirmed     Boolean          @default(false)
  payoutAmount  Float?
  payoutStatus  String           @default("PENDING")
  createdAt     DateTime         @default(now())
  period        EvaluationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([periodId, userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  projectId String
  actorId   String
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Dispute {
  id          String        @id @default(cuid())
  projectId   String
  userId      String
  scoreId     String?
  reason      String
  status      DisputeStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Score?        @relation(fields: [scoreId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

enum DisputeStatus {
  PENDING
  RESOLVED
  REJECTED
}

model Score {
  id                 String            @id @default(cuid())
  projectId          String
  userId             String
  value              Int
  reason             String
  evidenceEventId    String?
  milestoneId        String?
  kpiId              String?
  evaluationPeriodId String?
  suggestedBy        ScoreSource       @default(AI)
  flagged            Boolean           @default(false)
  flagReason         String?
  confirmed          Boolean           @default(false)
  createdAt          DateTime          @default(now())
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidenceEvent      EvidenceEvent?    @relation(fields: [evidenceEventId], references: [id])
  milestone          Milestone?        @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  kpi                Kpi?              @relation(fields: [kpiId], references: [id], onDelete: SetNull)
  evaluationPeriod   EvaluationPeriod? @relation(fields: [evaluationPeriodId], references: [id], onDelete: SetNull)
  disputes           Dispute[]

  @@index([projectId])
  @@index([evaluationPeriodId])
}

enum ScoreSource {
  AI
  LEAD
}

model TeamSummary {
  id          String   @id @default(cuid())
  projectId   String
  content     String
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
